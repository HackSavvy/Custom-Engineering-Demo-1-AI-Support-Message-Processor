# ─────────────────────────────────────────────────────────────
#  AI Support Message Processor — environment configuration
# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your key(s).
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── OpenAI (primary provider) ────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# Override the default OpenAI model (optional)
# OPENAI_MODEL=gpt-4o

# ── Anthropic / Claude (optional alternative provider) ───────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Override the default Claude model (optional)
# ANTHROPIC_MODEL=claude-sonnet-4-6
